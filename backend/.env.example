# --- Database ---
# Leave empty to run in DEMO MODE against an in-memory SQLite DB seeded with mock data.
# Fill in to use PostgreSQL, e.g:
# DATABASE_URL=postgresql://shopsmart:password@localhost:5432/shopsmart
DATABASE_URL=

# --- AI provider ---
# Leave empty to run with MockAIProvider (canned but realistic NLP extraction + chat replies).
# Fill in to use a real provider through RealAIProvider.
AI_API_KEY=
AI_API_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-6

# --- External product API (optional, Phase 4) ---
PRODUCT_API_KEY=
PRODUCT_API_BASE_URL=

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
